# Copy this file to .env.local (git-ignored) and adjust as needed.

# Backend origin used by the Vite dev/preview proxy.
VITE_BACKEND_TARGET=http://localhost:8080

# API origin baked into a production build. Leave unset to use the same origin.
# VITE_API_BASE_URL=https://api.example.com/

# React Query Devtools are opt-in in development and never bundled for production.
# VITE_ENABLE_QUERY_DEVTOOLS=true
